        GUILayout.Label(
            "Recorded losses: " + losses.ToString("N1") + " t",
            bodyStyle);

        GUILayout.Space(8);

        GUILayout.Label(
            "Current measured simulated stock: " +
            TotalStock().ToString("N1") + " t",
            sectionStyle);

        GUILayout.Label(
            "Cumulative transfer movement: " +
            totalMoved.ToString("N2") + " t",
