        GUILayout.BeginArea(
            new Rect(
                mainX + 12, topY + 10,
                mainWidth - 24, contentHeight - 20));

        switch (activeTab)
        {
            case PlantTab.PlantMap:
                DrawPlantMap();
                break;

            case PlantTab.Controls:
                DrawControls();
                break;

            case PlantTab.Inventory:
                DrawInventory();
                break;

            case PlantTab.Quality:
                DrawQuality();
                break;

            case PlantTab.Reports:
                DrawReports();
                break;

            case PlantTab.Missions:
                DrawMissions();
                break;
        }

        GUILayout.EndArea();

        GUI.Box(
            new Rect(
                width - rightWidth - 18,
                topY, rightWidth, contentHeight),
            GUIContent.none,
            panelStyle);

        DrawRightPanel(
            width - rightWidth - 6,
            topY + 10,
            rightWidth - 24,
            contentHeight - 20);

        GUI.color = new Color(0.12f, 0.38f, 0.19f);

        GUI.DrawTexture(
            new Rect(0, height - 18, width, 18),
            greenTex);

        GUI.color = Color.white;

        GUI.Label(
            new Rect(18, height - 18, width - 36, 18),
            "Healthy Grain • Smart Decisions • Sustainable Future",
            smallStyle);

        GUI.matrix = Matrix4x4.identity;
    }

    private void DrawLeftPanel(
        float x, float y, float width, float height)
    {
        GUILayout.BeginArea(new Rect(x, y, width, height));

        GUILayout.Label("EQUIPMENT STATUS", sectionStyle);
        GUILayout.Space(8);

        foreach (EquipmentData item in equipment)
        {
            GUILayout.BeginHorizontal();

            GUILayout.Label(
                item.name,
                bodyStyle,
                GUILayout.Width(width * 0.66f));

            GUILayout.Label(
                item.faulted ? "FAULT" :
                (item.running ? "RUN" : "STBY"),
                item.faulted ? warningStyle :
                (item.running ? goodStyle : smallStyle));

            GUILayout.EndHorizontal();
            GUILayout.Space(3);
        }

        GUILayout.Space(10);
        GUILayout.Label("ACTIVE INTERLOCKS", sectionStyle);

        GUILayout.Label(
            safetyInterlock
                ? "Transfer inhibited — investigate alarm."
                : "No active safety interlock.",
            safetyInterlock ? warningStyle : goodStyle);

        GUILayout.Space(8);

        if (GUILayout.Button(
            emergencyStop ? "RESET E-STOP" : "EMERGENCY STOP",
            buttonStyle))
        {
            if (!emergencyStop)
            {
                emergencyStop = true;
                plantRunning = false;

                StopTransfer("Emergency stop activated.");
                LogAlarm("Emergency stop activated.");
            }
            else
            {
                emergencyStop = false;

                safetyInterlock =
                    activeFault != FaultType.None || !gateAligned;

                LogAction(
                    "Emergency stop reset; inspect before restart.");
            }
        }

        if (GUILayout.Button(
            plantRunning ? "STOP PLANT" : "START PLANT",
            buttonStyle))
        {
            if (plantRunning)
            {
                plantRunning = false;
                StopTransfer("Plant stopped by operator.");
            }
            else if (!emergencyStop &&
                     activeFault == FaultType.None)
            {
                plantRunning = true;
                LogAction("Plant started.");
            }
            else
            {
                aiMessage =
                    "Cannot start: reset E-stop and resolve active faults first.";
            }
        }

        GUILayout.Space(8);
        GUILayout.Label("LAST OPERATOR ACTION", sectionStyle);
        GUILayout.Label(lastAction, smallStyle);

        GUILayout.EndArea();
    }

    private void DrawRightPanel(
        float x, float y, float width, float height)
    {
        GUILayout.BeginArea(new Rect(x, y, width, height));

        GUILayout.Label("PLANT OVERVIEW", sectionStyle);
        GUILayout.Label("Total stored grain", smallStyle);
        GUILayout.Label(TotalStock().ToString("N1") + " t", titleStyle);

        GUILayout.Label("Transfer rate", smallStyle);
        GUILayout.Label(
            (transferEnabled ? transferRate : 0f).ToString("N0") + " t/h",
            sectionStyle);

        GUILayout.Label("Quality score", smallStyle);
        GUILayout.Label(
            qualityScore.ToString("N0") + " / 100",
            sectionStyle);

        GUILayout.Label("Active fault", smallStyle);
        GUILayout.Label(
            activeFault == FaultType.None
                ? "None"
                : activeFault.ToString(),
            activeFault == FaultType.None
                ? goodStyle
                : warningStyle);

        GUILayout.Space(8);
        GUILayout.Label("SILO LEVELS", sectionStyle);

        for (int i = 0; i < silos.Count; i++)
        {
            float fill = silos[i].tonnes / silos[i].capacity;

            GUILayout.BeginHorizontal();

            GUILayout.Label(
                silos[i].name,
                smallStyle,
                GUILayout.Width(54));

            Rect bar = GUILayoutUtility.GetRect(
                width - 105, 14);

            GUI.color = new Color(0.12f, 0.28f, 0.19f);
            GUI.DrawTexture(bar, darkTex);

            GUI.color = fill > 0.85f
                ? new Color(0.9f, 0.58f, 0.16f)
                : new Color(0.36f, 0.78f, 0.28f);

            GUI.DrawTexture(
                new Rect(
                    bar.x, bar.y,
                    bar.width * Mathf.Clamp01(fill),
                    bar.height),
                greenTex);

            GUI.color = Color.white;

            GUILayout.Label(
                (fill * 100f).ToString("F0") + "%",
                smallStyle,
                GUILayout.Width(38));

            GUILayout.EndHorizontal();
        }

        GUILayout.Space(8);
        GUILayout.Label("AI PLANT ADVISOR", sectionStyle);
        GUILayout.Label(aiMessage, bodyStyle, GUILayout.MinHeight(95));

        if (GUILayout.Button(
            "GENERATE RECOMMENDATION",
            buttonStyle))
        {
            BuildAIRecommendation();
        }

        if (activeFault != FaultType.None &&
            GUILayout.Button(
                "ACKNOWLEDGE / CLEAR SIMULATED FAULT",
                buttonStyle))
        {
            InjectFault(FaultType.None);
            safetyInterlock = false;
        }

        GUILayout.EndArea();
    }

