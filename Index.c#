    private void DrawNodeCard(
        string name, float tonnes, float capacity)
    {
        GUILayout.BeginVertical(
            panelStyle,
            GUILayout.MinWidth(80),
            GUILayout.ExpandWidth(true));

        GUILayout.Label(name, smallStyle);
        GUILayout.Label(tonnes.ToString("F0") + " t", sectionStyle);

        float fill = capacity > 0
            ? tonnes / capacity
            : 0;

        GUILayout.Label(
            (fill * 100f).ToString("F0") + "% full",
            smallStyle);

        GUILayout.EndVertical();
    }

    private void DrawControls()
    {
        GUILayout.Label("OPERATOR CONTROLS", titleStyle);

        GUILayout.Label(
            "A transfer is simulated only after route validation. " +
            "Faults and interlocks inhibit movement.",
            smallStyle);

        GUILayout.Space(10);
        GUILayout.Label("Transfer source", sectionStyle);

        sourceIndex = GUILayout.SelectionGrid(
            sourceIndex, nodeNames, 3, buttonStyle);

        GUILayout.Space(8);
        GUILayout.Label("Transfer destination", sectionStyle);

        destinationIndex = GUILayout.SelectionGrid(
            destinationIndex, nodeNames, 3, buttonStyle);

        GUILayout.Space(8);

        GUILayout.Label(
            "Requested transfer rate: " +
            transferRate.ToString("F0") + " t/h",
            bodyStyle);

        transferRate = GUILayout.HorizontalSlider(
            transferRate, 10f, 120f);

        GUILayout.Label(
            "Intake moisture: " +
            moistureInput.ToString("F1") + "%",
            bodyStyle);

        moistureInput = GUILayout.HorizontalSlider(
            moistureInput, 8f, 30f);

        GUILayout.Space(8);
        GUILayout.BeginHorizontal();

        if (GUILayout.Button("START TRANSFER", buttonStyle))
            StartTransfer();

        if (GUILayout.Button("STOP TRANSFER", buttonStyle))
            StopTransfer("Operator stop.");

        GUILayout.EndHorizontal();

        GUILayout.Space(10);
        GUILayout.Label("DIVERTER GATE", sectionStyle);
        GUILayout.BeginHorizontal();

        if (GUILayout.Button(
            gateAligned ? "GATE ALIGNED" : "ALIGN GATE",
            buttonStyle))
        {
            gateAligned = true;
            safetyInterlock = activeFault != FaultType.None;

            LogAction("Gate alignment command issued.");
        }

        if (GUILayout.Button("SIMULATE MISMATCH", buttonStyle))
            InjectFault(FaultType.GateMismatch);

        GUILayout.EndHorizontal();

        GUILayout.Space(8);
        GUILayout.Label(
            "FAULT INJECTION (TRAINING ONLY)",
            sectionStyle);

        GUILayout.BeginHorizontal();

        if (GUILayout.Button("Blockage", buttonStyle))
            InjectFault(FaultType.ConveyorBlockage);

        if (GUILayout.Button("Belt slip", buttonStyle))
            InjectFault(FaultType.BeltSlip);

        if (GUILayout.Button("Sensor", buttonStyle))
            InjectFault(FaultType.LevelSensor);

        GUILayout.EndHorizontal();
        GUILayout.BeginHorizontal();

        if (GUILayout.Button("Bearing hot", buttonStyle))
            InjectFault(FaultType.ElevatorBearing);

        if (GUILayout.Button("Dryer hot", buttonStyle))
            InjectFault(FaultType.DryerOverheat);

        if (GUILayout.Button("Clear fault", buttonStyle))
            InjectFault(FaultType.None);

        GUILayout.EndHorizontal();

        GUILayout.Space(10);
        GUILayout.Label("DRYER / FURNACE SIMULATION", sectionStyle);

        GUILayout.Label(
            "Dryer setpoint: " +
            dryerSetpoint.ToString("F0") + " °C",
            bodyStyle);

        dryerSetpoint = GUILayout.HorizontalSlider(
            dryerSetpoint, 35f, 90f);

        GUILayout.Label(
            "Furnace outlet setpoint: " +
            furnaceSetpoint.ToString("F0") + " °C",
            bodyStyle);

        furnaceSetpoint = GUILayout.HorizontalSlider(
            furnaceSetpoint, 80f, 240f);

        if (GUILayout.Button(
            "APPLY SIMULATED SETPOINTS",
            buttonStyle))
        {
            if (dryerSetpoint > 80f ||
                furnaceSetpoint > 220f)
            {
                InjectFault(FaultType.DryerOverheat);

                aiMessage =
                    "High simulated setpoint triggers protective " +
                    "interlock. These values are game rules, " +
                    "not operating specifications.";
            }
            else
            {
                LogAction(
                    "Simulated dryer/furnace setpoints updated.");

                aiMessage =
                    "Setpoints accepted by the simplified game model. " +
                    "Real settings must follow grain-specific design " +
                    "and manufacturer procedures.";
            }
        }
    }

