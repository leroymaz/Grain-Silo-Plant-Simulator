    {
        GUILayout.Label("INVENTORY & TONNAGE", titleStyle);

        GUILayout.Label(
            "Mass balance values update as simulated grain transfers occur.",
            smallStyle);

        GUILayout.Space(10);

        GUILayout.Label(
            "Opening stock: " + openingStock.ToString("N1") + " t",
