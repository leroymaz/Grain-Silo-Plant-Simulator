    private void Update()
    {
        float dt = Time.deltaTime * simulationSpeed;
        elapsed += dt;

        if (plantRunning && !emergencyStop)
        {
            foreach (EquipmentData item in equipment)
            {
                if (item.running && !item.faulted)
                {
                    item.temperature = Mathf.Clamp(
                        item.temperature +
                        Mathf.Sin(elapsed * 0.2f) * 0.02f,
                        20f,
                        95f);
                }
            }
        }

        if (transferEnabled &&
            plantRunning &&
            !emergencyStop &&
            !safetyInterlock)
        {
            if (activeFault != FaultType.None)
            {
                transferEnabled = false;

                aiMessage =
                    "Transfer inhibited: an active fault requires " +
                    "diagnosis before grain movement can continue.";

                LogAlarm(
                    "Transfer inhibited by active fault: " +
                    activeFault);
            }
            else if (!gateAligned)
            {
                transferEnabled = false;
                safetyInterlock = true;

                aiMessage =
                    "Safety interlock: diverter gate position " +
                    "does not match the requested route.";

                LogAlarm("Gate mismatch interlock.");
            }
            else
            {
                float amount = Mathf.Min(
                    transferRate * dt / 3600f,
                    2f);

                if (CanTransfer(
                    sourceIndex,
                    destinationIndex,
                    amount))
                {
                    MoveGrain(
                        sourceIndex,
                        destinationIndex,
                        amount);

                    totalMoved += amount;
                    throughput = transferRate;
                    missionElapsed += dt;
                }
                else
                {
                    transferEnabled = false;

                    aiMessage =
                        "Transfer stopped: source stock, destination " +
                        "capacity or route constraints failed validation.";

                    LogAlarm("Route validation blocked transfer.");
                }
            }
        }

        UpdateSiloVisuals();
    }

    private void UpdateSiloVisuals()
    {
        for (int i = 0; i < silos.Count; i++)
        {
            if (silos[i].visual != null)
            {
                float fill = Mathf.Clamp01(
                    silos[i].tonnes / silos[i].capacity);

                Renderer renderer =
                    silos[i].visual.GetComponent<Renderer>();

                renderer.material.color = fill > 0.85f
                    ? new Color(0.76f, 0.56f, 0.22f)
                    : new Color(0.65f, 0.69f, 0.64f);
            }
        }
    }

    private bool CanTransfer(
        int source,
        int destination,
        float amount)
    {
        if (source == destination)
            return false;

        float stock = GetNodeTonnes(source);
        float capacity = GetNodeCapacity(destination);

        if (stock < amount)
            return false;

        if (capacity - GetNodeTonnes(destination) < amount)
            return false;

        if (source == 9 && destination != 10 && destination < 2)
            return false;

        if (destination == 9 && source == 10)
            return false;

        if (source == 0 && destination == 10)
            return false;

        return true;
    }

    private void MoveGrain(
        int source,
        int destination,
        float amount)
    {
        SetNodeTonnes(
            source,
            GetNodeTonnes(source) - amount);

        SetNodeTonnes(
            destination,
            GetNodeTonnes(destination) + amount);

        if (source == 0)
            receipts += amount;

        if (destination == 10)
            dispatches += amount;

        if (source == 10)
            dispatches -= amount;

        lastAction =
            "Moved " + amount.ToString("F2") +
            " t: " + nodeNames[source] +
            " → " + nodeNames[destination];
    }

    private float GetNodeTonnes(int node)
    {
        if (node == 0)
            return receivingTonnes;

        if (node == 1)
            return holdingTonnes;

        if (node >= 2 && node <= 8)
            return silos[node - 2].tonnes;

        if (node == 9)
            return 0f;

        return dispatchTonnes;
    }

    private float GetNodeCapacity(int node)
    {
        if (node == 0)
            return 500f;

        if (node == 1)
            return 250f;

        if (node >= 2 && node <= 8)
            return silos[node - 2].capacity;

        if (node == 9)
            return 150f;

        return 300f;
    }

    private void SetNodeTonnes(int node, float value)
    {
        value = Mathf.Max(0f, value);

        if (node == 0)
            receivingTonnes = value;
        else if (node == 1)
            holdingTonnes = value;
        else if (node >= 2 && node <= 8)
            silos[node - 2].tonnes = value;
        else if (node == 10)
            dispatchTonnes = value;
    }

    private float TotalStock()
    {
        float total =
            receivingTonnes +
            holdingTonnes +
            dispatchTonnes;

        foreach (SiloData silo in silos)
            total += silo.tonnes;

        return total;
    }

    private void LogAction(string message)
    {
        actionLog.Insert(
            0,
            DateTime.Now.ToString("HH:mm:ss") +
            "  " + message);

        if (actionLog.Count > 100)
            actionLog.RemoveAt(actionLog.Count - 1);

        lastAction = message;
    }

    private void LogAlarm(string message)
    {
        alarmLog.Insert(
            0,
            DateTime.Now.ToString("HH:mm:ss") +
            "  " + message);

        if (alarmLog.Count > 100)
            alarmLog.RemoveAt(alarmLog.Count - 1);
    }

    private void StartTransfer()
    {
        if (emergencyStop)
        {
            aiMessage = "Reset the emergency stop before restarting.";
            return;
        }

        if (!plantRunning)
        {
            aiMessage = "Start the plant before requesting a transfer.";
            return;
        }

        if (activeFault != FaultType.None)
        {
            aiMessage =
                "Resolve or acknowledge the active fault in Controls before starting.";
            return;
        }

        if (!gateAligned)
        {
            safetyInterlock = true;
            aiMessage =
                "Route gate mismatch. Align the gate before starting.";
            return;
        }

        if (sourceIndex == destinationIndex)
        {
            aiMessage =
                "Choose different source and destination nodes.";
            return;
        }

        if (!CanTransfer(
            sourceIndex,
            destinationIndex,
            0.1f))
        {
            aiMessage =
                "Route cannot start: check stock, destination " +
                "headroom and route compatibility.";
            return;
        }

        transferEnabled = true;
        safetyInterlock = false;

        LogAction(
            "Transfer started: " +
            nodeNames[sourceIndex] + " → " +
            nodeNames[destinationIndex]);

        aiMessage =
            "Route checks passed. Monitoring flow, inventory " +
            "balance and equipment status.";
    }

    private void StopTransfer(string reason)
    {
        transferEnabled = false;
        LogAction("Transfer stopped. " + reason);
    }

    private void InjectFault(FaultType fault)
    {
        activeFault = fault;
        transferEnabled = false;
        safetyInterlock = fault != FaultType.None;

        foreach (EquipmentData item in equipment)
            item.faulted = false;

        if (fault == FaultType.ConveyorBlockage)
            equipment[2].faulted = true;

        if (fault == FaultType.BeltSlip)
            equipment[0].faulted = true;

        if (fault == FaultType.ElevatorBearing)
        {
            equipment[1].faulted = true;
            equipment[1].temperature = 92f;
        }

        if (fault == FaultType.DryerOverheat)
        {
            equipment[4].faulted = true;
            equipment[5].faulted = true;
        }

        if (fault == FaultType.GateMismatch)
            gateAligned = false;

        if (fault == FaultType.None)
        {
            gateAligned = true;

            foreach (EquipmentData item in equipment)
            {
                item.faulted = false;
                item.temperature = 35f;
            }
        }

        LogAlarm(
            fault == FaultType.None
                ? "Fault cleared after simulated inspection."
                : "Fault injected: " + fault);

        DiagnoseFault();
    }

    private void DiagnoseFault()
    {
        switch (activeFault)
        {
            case FaultType.None:
                aiMessage =
                    "No active simulated fault. Continue monitoring flow and quality.";
                safetyInterlock = false;
                break;

            case FaultType.ConveyorBlockage:
                aiMessage =
                    "LIKELY BLOCKAGE: Stop upstream feed, verify downstream " +
                    "flow and sensor indications, isolate the simulated " +
                    "equipment, then inspect the chute. Do not clear a real " +
                    "blockage while machinery is energized.";
                break;

            case FaultType.BeltSlip:
                aiMessage =
                    "BELT SLIP SUSPECTED: Compare commanded and measured " +
                    "belt speed, inspect drive feedback and tension " +
                    "indicators, and keep the route inhibited until checked.";
                break;

            case FaultType.LevelSensor:
                aiMessage =
                    "LEVEL SENSOR DISAGREEMENT: Cross-check independent " +
                    "level or weight measurements. Prevent filling based " +
                    "only on an unreliable reading.";
                break;

            case FaultType.ElevatorBearing:
                aiMessage =
                    "BEARING OVERHEAT: Simulated bearing temperature is " +
                    "elevated. Stop the affected elevator under the site " +
                    "procedure and investigate lubrication, alignment " +
                    "and bearing condition.";
                break;

            case FaultType.DryerOverheat:
                aiMessage =
                    "DRYER/FURNACE OVER-TEMPERATURE: Burner and dryer " +
                    "operation are inhibited. Follow the real equipment " +
                    "manufacturer's safeguards; never bypass burner trips.";
                break;

            case FaultType.GateMismatch:
                aiMessage =
                    "DIVERTER POSITION MISMATCH: Requested route and " +
                    "feedback disagree. Keep transfer stopped and verify " +
                    "the correct route and gate indication.";
                break;
        }
    }

    private void BuildAIRecommendation()
    {
        int highest = 0;

        for (int i = 1; i < silos.Count; i++)
        {
            if (silos[i].tonnes / silos[i].capacity >
                silos[highest].tonnes / silos[highest].capacity)
            {
                highest = i;
            }
        }

        if (activeFault != FaultType.None)
        {
            DiagnoseFault();
        }
        else if (silos[highest].tonnes / silos[highest].capacity > 0.85f)
        {
            aiMessage =
                silos[highest].name + " is at " +
                (silos[highest].tonnes / silos[highest].capacity * 100f)
                .ToString("F0") +
                "% capacity. Pause incoming routes to it and select a silo with enough headroom.";
        }
        else if (moistureInput > 14f)
        {
            aiMessage =
                "Incoming moisture is " + moistureInput.ToString("F1") +
                "%. Check the grain-specific intake specification and " +
                "consider a validated dryer route before long-term storage.";
        }
        else
        {
            aiMessage =
                "No active fault. Confirm route, headroom, gate feedback " +
                "and equipment readiness. Track mass balance after every transfer.";
        }
    }

