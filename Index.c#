    private void DrawQuality()
    {
        GUILayout.Label("GRAIN QUALITY LAB", titleStyle);

        GUILayout.Label(
            "Illustrative quality readings for training; " +
            "not a substitute for sampling or calibrated instruments.",
            smallStyle);

        GUILayout.Space(10);

        int selected = Mathf.Clamp(destinationIndex - 2, 0, 6);
        SiloData silo = silos[selected];

        GUILayout.Label(
            "Selected quality record: " + silo.name,
            sectionStyle);

        GUILayout.Label(
            "Moisture: " + silo.moisture.ToString("F1") + "%",
            bodyStyle);

        GUILayout.Label(
            "Temperature: " + silo.temperature.ToString("F1") + " °C",
            bodyStyle);

        GUILayout.Label(
            "Impurities: " + silo.impurities.ToString("F1") + "%",
            bodyStyle);

        GUILayout.Label(
            "Overall plant quality score: " +
            qualityScore.ToString("F0") + " / 100",
            sectionStyle);

        GUILayout.Space(8);

        GUILayout.Label(
            "Incoming moisture estimate: " +
            moistureInput.ToString("F1") + "%",
            bodyStyle);

        if (GUILayout.Button("RUN QUALITY SCREEN", buttonStyle))
        {
            qualityScore = Mathf.Clamp(
                100f -
                Mathf.Max(0, moistureInput - 13f) * 1.4f -
                (activeFault == FaultType.DryerOverheat ? 12f : 0f),
                40f,
                100f);

            if (moistureInput > 14f)
            {
                aiMessage =
                    "Quality screen flags incoming moisture for review. " +
                    "Confirm grain species, contract specification " +
                    "and approved drying target.";
            }
            else
            {
                aiMessage =
                    "Quality screen passed the simplified intake check. " +
                    "Continue representative sampling and storage-condition monitoring.";
            }

            LogAction("Quality screening performed.");
        }

        GUILayout.Space(10);
        GUILayout.Label("AI QUALITY GUIDANCE", sectionStyle);

        GUILayout.Label(
            "• Sample incoming grain and verify the grain-specific acceptance limit.\n" +
            "• Trend grain temperature and moisture during storage.\n" +
            "• Separate batches when quality, grade or traceability differs.\n" +
            "• Investigate hot spots and abnormal moisture trends early.",
            bodyStyle);
    }

    private void DrawReports()
    {
        GUILayout.Label("EVENTS & REPORTS", titleStyle);
        GUILayout.Label("Recent operator actions", sectionStyle);

        reportScroll = GUILayout.BeginScrollView(
            reportScroll, GUILayout.Height(170));

        foreach (string entry in actionLog)
            GUILayout.Label("• " + entry, smallStyle);

        GUILayout.EndScrollView();

        GUILayout.Space(8);
        GUILayout.Label("Alarm history", sectionStyle);

        logScroll = GUILayout.BeginScrollView(
            logScroll, GUILayout.Height(170));

        if (alarmLog.Count == 0)
            GUILayout.Label("No alarms recorded.", goodStyle);

        foreach (string entry in alarmLog)
            GUILayout.Label("! " + entry, warningStyle);

        GUILayout.EndScrollView();

        if (GUILayout.Button(
            "EXPORT SUMMARY TO CONSOLE",
            buttonStyle))
        {
            Debug.Log(
                "SILO PLANT REPORT | Stock=" +
                TotalStock().ToString("F2") +
                " t | Throughput=" + throughput +
                " t/h | Fault=" + activeFault);

            LogAction("Summary written to Unity Console.");
        }
    }

    private void DrawMissions()
    {
        GUILayout.Label("LEARNING MISSIONS", titleStyle);

        string[] names =
        {
            "Mission 1 — Safe Receiving",
            "Mission 2 — Route & Silo Selection",
            "Mission 3 — Diagnose a Conveyor Fault",
            "Mission 4 — Protect Grain Quality",
            "Mission 5 — Dispatch & Reconcile Stock"
        };

        string[] descriptions =
        {
            "Accept an intake batch, verify the holding bin has headroom and start a safe route.",
            "Choose a silo with sufficient free capacity and confirm the route before moving grain.",
            "Inject a blockage or belt-slip fault, interpret the AI diagnosis and clear the simulated fault.",
            "Review moisture, temperature and dryer conditions before approving long-term storage.",
            "Move stock to dispatch and compare the movement record with the inventory report."
        };

        missionIndex = Mathf.Clamp(
            missionIndex, 0, names.Length - 1);

        GUILayout.Label(names[missionIndex], sectionStyle);
        GUILayout.Label(descriptions[missionIndex], bodyStyle);

        GUILayout.Space(8);

        GUILayout.Label(
            "Progress time: " +
            (missionElapsed / 60f).ToString("F1") +
            " simulated minutes",
            bodyStyle);

        GUILayout.Label(
            "Operator XP: " + xp +
            "    Training credits: " + credits,
            bodyStyle);

        GUILayout.Space(8);

        if (GUILayout.Button("PREVIOUS MISSION", buttonStyle))
        {
            missionIndex =
                (missionIndex + names.Length - 1) % names.Length;
        }

        if (GUILayout.Button("NEXT MISSION", buttonStyle))
        {
            missionIndex = (missionIndex + 1) % names.Length;
        }

        if (GUILayout.Button(
            "COMPLETE / SCORE MISSION",
            buttonStyle))
        {
            bool success =
                activeFault == FaultType.None &&
                !emergencyStop &&
                (missionIndex != 1 ||
                 silos.Exists(
                     silo => silo.capacity - silo.tonnes > 100f));

            if (success)
            {
                xp += 100;
                credits += 25;

                aiMessage =
                    "Mission passed. +100 XP and +25 credits. " +
                    "Review the event log for your operating record.";

                LogAction(
                    "Mission passed: " + names[missionIndex]);
            }
            else
            {
                aiMessage =
                    "Mission not passed yet. Resolve faults, reset " +
                    "interlocks and verify the required operating conditions.";

                LogAction(
                    "Mission attempt unsuccessful: " +
                    names[missionIndex]);
            }
        }

        GUILayout.Space(10);
        GUILayout.Label("SCORING PRINCIPLES", sectionStyle);

        GUILayout.Label(
            "Safety first • Correct routing • Inventory accuracy • " +
            "Grain quality • Fault diagnosis • Efficient operation",
            bodyStyle);
    }

    private void OnGUI()
    {
        if (titleStyle == null)
            BuildStyles();

        BuildUI();
    }
